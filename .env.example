# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PERSONALIZE / SNAPCASE E-COMMERCE
# ==============================================================================

# SUPABASE (POSTGRESQL & AUTH)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# CLOUDFLARE R2 (STORAGE DE IMAGENS)
# Obtenha em: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="seu-r2-account-id"
R2_ACCESS_KEY_ID="seu-r2-access-key-id"
R2_SECRET_ACCESS_KEY="sua-r2-secret-access-key"
R2_BUCKET_NAME="personalize"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-seu-hash.r2.dev"

# CONFIGURAÇÕES DE AUTENTICAÇÃO DO ADMINISTRADOR / LOJISTA
ADMIN_EMAIL="admin@seu-dominio.com"
ADMIN_SECRET_KEY="sua-senha-secreta-admin-aqui"

# ==============================================================================
# MELHOR ENVIO (LOGÍSTICA, COTAÇÃO & ETIQUETAS)
# ==============================================================================

# AMBIENTE ATIVO: "sandbox" (testes) ou "production" (produção real do lojista)
MELHOR_ENVIO_ENV="sandbox"

# DADOS DE ORIGEM / EXPEDIÇÃO DA LOJA (para cálculo de frete e etiquetas)
MELHOR_ENVIO_FROM_CEP="01001000"
MELHOR_ENVIO_APP_CONTACT="contato@seu-dominio.com"
MELHOR_ENVIO_FROM_NAME="Personalize Cases Store"
MELHOR_ENVIO_FROM_PHONE="11988887777"
MELHOR_ENVIO_FROM_DOCUMENT="29410948000109" # CNPJ ou CPF do remetente
MELHOR_ENVIO_FROM_ADDRESS="Avenida Paulista"
MELHOR_ENVIO_FROM_NUMBER="1000"
MELHOR_ENVIO_FROM_COMPLEMENT="Sala 101"
MELHOR_ENVIO_FROM_DISTRICT="Bela Vista"
MELHOR_ENVIO_FROM_CITY="São Paulo"
MELHOR_ENVIO_FROM_STATE="SP"

# ------------------------------------------------------------------------------
# 1. AMBIENTE DE SANDBOX (SUA CONTA DE DESENVOLVEDOR / TESTES)
# Painel: https://sandbox.melhorenvio.com.br
# ------------------------------------------------------------------------------
MELHOR_ENVIO_SANDBOX_URL="https://sandbox.melhorenvio.com.br"
MELHOR_ENVIO_SANDBOX_TOKEN="seu-token-sandbox-aqui"
MELHOR_ENVIO_SANDBOX_CLIENT_ID="seu-client-id-sandbox"
MELHOR_ENVIO_SANDBOX_CLIENT_SECRET="seu-client-secret-sandbox"

# ------------------------------------------------------------------------------
# 2. AMBIENTE DE PRODUÇÃO (CONTA OFICIAL DO DONO DA LOJA)
# Painel: https://www.melhorenvio.com.br
# ------------------------------------------------------------------------------
MELHOR_ENVIO_PROD_URL="https://www.melhorenvio.com.br"
MELHOR_ENVIO_PROD_TOKEN="token-producao-do-dono-da-loja"
MELHOR_ENVIO_PROD_CLIENT_ID="client-id-producao-do-dono"
MELHOR_ENVIO_PROD_CLIENT_SECRET="client-secret-producao-do-dono"

# URL de callback caso utilize autorização via OAuth (opcional se usar Token Direto)
MELHOR_ENVIO_REDIRECT_URI="http://localhost:3000/api/shipping/callback"

